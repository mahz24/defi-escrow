# RPC endpoint for Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Name of the encrypted Foundry keystore used to sign the deployment.
# Create it once with: cast wallet import deployer --interactive
ACCOUNT=deployer

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
